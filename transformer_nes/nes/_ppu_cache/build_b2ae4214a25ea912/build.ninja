ninja_required_version = 1.3
cxx = c++

cflags = -DTORCH_EXTENSION_NAME=nes_ppu_b2ae4214a25ea912 -DTORCH_API_INCLUDE_EXTENSION_H -isystem /Users/kylelukaszek/Projects/transformer-vm/.venv/lib/python3.13/site-packages/torch/include -isystem /Users/kylelukaszek/Projects/transformer-vm/.venv/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -isystem /Users/kylelukaszek/.local/share/uv/python/cpython-3.13.7-macos-aarch64-none/include/python3.13 -fPIC -std=c++17 -O2 -std=c++17
post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/Users/kylelukaszek/Projects/transformer-vm/.venv/lib/python3.13/site-packages/torch/lib -lc10 -ltorch_cpu -ltorch -ltorch_python -undefined dynamic_lookup

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc





rule link
  command = $cxx $in $ldflags -o $out

build ppu.o: compile /Users/kylelukaszek/Projects/transformer-vm/transformer_nes/nes/ppu.cpp





build nes_ppu_b2ae4214a25ea912.so: link ppu.o

default nes_ppu_b2ae4214a25ea912.so
